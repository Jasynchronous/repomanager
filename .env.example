# Register a GitHub OAuth App: https://github.com/settings/developers
# Set the OAuth callback URL to http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret

# Strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace_with_random_32_byte_secret
NEXTAUTH_URL=http://localhost:3000

# Required! Only this GitHub user can log in and manage their own repos.
ALLOWED_GITHUB_USERNAME=your-github-username
